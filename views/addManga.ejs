<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="module" src="/scripts/addManga.js" defer></script>
    <link rel="stylesheet" href="/styles/forms.css">
    <link rel="stylesheet" href="/styles/partials/dialogForm.css">
    <link rel="stylesheet" href="/styles/mangaForms.css">
    <title><%= title %></title>
</head>
<body>
    <%- include('partials/header') %>
    <div class="main-content">
        <h1><%= title %></h1>
        <%- include('partials/errors.ejs') %>
        <form  class="form" action="/add" method="POST">
            <div class="form-group">
                <label for="title">Title</label>
                <input type="text" id="title" name="title" placeholder="Enter manga title" required>
            </div>
            <div class="form-group">
                <label for="description">Description</label>
                <textarea name="description" id="description" placeholder="Enter manga description"></textarea>
            </div>
            <select name="status" id="status" required>
                <% statuses.forEach(status => { %>
                    <option><%= status %></option>
                <% }) %<% }) %>
            </select>
        </form>
    </div>
</body>
</html>