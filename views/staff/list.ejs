<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/partials/pageActions.css">
  <link rel="stylesheet" href="/styles/staff/list.css">
  <title><%= title %></title>
</head>
<body>
  <%- include('../partials/header') %>
  <main>
    <div class="staff-list-title">
      <h1><%= title %></h1>
      <a class="page-action" href="/staff/add">Add Staff Member</a>
    </div>
    <div class="staff-list-header">
      <p>Name</p>
      <p>Gender</p>
      <p>Actions</p>
    </div>
    <ul>
      <% staff.forEach(member => { %>
        <li class="staff-member">
          <a href="/staff/<%= member.id %>/detail"><%= member.fullname %></a>
          <p><%= member.gender || '-' %></p>
          <div class="actions">
            <a href="/staff/<%= member.id %>/update" aria-label="Edit <%= member.fullname %>" title="Edit">U</a>
            <form action="/staff/<%= member.id %>/delete" method="POST">
              <button type="submit" aria-label="Delete <%= member.fullname %>" title="Delete">D</button>
            </form>
          </div>
        </li>
      <% }); %>
    </ul>
  </main>
</body>
</html>